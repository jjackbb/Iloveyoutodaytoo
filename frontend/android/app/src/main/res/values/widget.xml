<?xml version="1.0" encoding="utf-8"?>
<!--
  위젯 전용 값. 브랜드(로고·색)가 아직 정해지지 않아 일부러 중성 회색 + 흰 바탕 +
  시스템 기본 폰트로만 둔다. 디자인 세션에서 이 파일의 색만 바꾸면 위젯 전체가 따라온다.
  값을 레이아웃에 직접 박지 말고 반드시 여기를 거칠 것.
-->
<resources>
    <color name="widget_surface">#FFFFFFFF</color>
    <color name="widget_text_primary">#FF1F2023</color>
