    <color name="widget_photo_placeholder">#FFE4E5E7</color>
    <color name="widget_button_surface">#FFEFEFF1</color>
    <color name="widget_button_text">#FF3A3D42</color>

    <dimen name="widget_padding">14dp</dimen>
